# --- Twilio ---
# Account SID + Auth Token from console.twilio.com dashboard.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# API Key SID + Secret: Console -> Account -> API keys & tokens -> Create API key.
# These sign the browser Voice Access Token (NOT the auth token).
TWILIO_API_KEY=
TWILIO_API_SECRET=
# TwiML App SID: Console -> Voice -> TwiML Apps. Set its Voice Request URL to
# https://<your-ngrok-host>/twiml/voice (HTTP POST).
TWILIO_TWIML_APP_SID=
# Your Twilio trial number (E.164), used as the <Dial> caller ID.
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# --- Deepgram (streaming speech-to-text) ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# en-IN by default; use "multi" for heavy Hinglish (Hindi/English code-switching).
DEEPGRAM_LANGUAGE=en-IN
# Live transcript tuning (milliseconds; does not set the model response latency).
STT_ENDPOINTING_MS=200
# Retain up to this much audio during connection setup/reconnect.
STT_AUDIO_BUFFER_SECONDS=2
# Keep punctuation, but avoid waiting for formatted dates/currency/phone numbers.
STT_SMART_FORMAT=false

# --- Groq (coaching + summary LLM, free tier) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# New confirmed speech is coalesced without canceling an in-flight request.
COACH_DEBOUNCE_SECONDS=3
COACH_MIN_INTERVAL_SECONDS=12
COACH_TIMEOUT_SECONDS=8
# GPT-OSS additionally needs a completion budget for internal reasoning.
COACH_MAX_TOKENS=350

# --- Call recording (one stereo WAV per call: agent left, customer right) ---
RECORD_CALLS=true
RECORDINGS_DIR=data/recordings

# --- Public tunnel (ngrok) ---
# Host only, no scheme, e.g. abc123.ngrok-free.app
# Twilio must reach the backend here; update this AND the TwiML App URL if the
# tunnel changes, then restart uvicorn.
PUBLIC_BASE_URL=

# --- CORS (frontend origins, comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
